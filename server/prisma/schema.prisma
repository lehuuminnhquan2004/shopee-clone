// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider              = "prisma-client"
  output                = "../src/generated/prisma"
  moduleFormat          = "esm"
  generateFileExtension = "ts"
  importFileExtension   = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           BigInt   @id @default(autoincrement())
  username     String   @unique @db.VarChar(50)
  email        String?  @unique @db.VarChar(255)
  fullName     String?  @map("full_name") @db.VarChar(100)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("users")
}

model Category {
  id       BigInt  @id @default(autoincrement())
  parentId BigInt? @map("parent_id")
  name     String  @db.VarChar(100)
  slug     String  @unique @db.VarChar(120)
  level    Int     @default(1) @db.SmallInt
  path     String  @default("") @db.VarChar(255)
  iconUrl  String? @map("icon_url") @db.VarChar(500)
  position Int     @default(0)
  isLeaf   Boolean @default(true) @map("is_leaf")
  isActive Boolean @default(true) @map("is_active")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children Category[] @relation("CategoryTree")

  @@index([parentId], map: "idx_categories_parent")
  @@index([path], map: "idx_categories_path")
  @@map("categories")
}
