// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider              = "prisma-client"
  output                = "../src/generated/prisma"
  moduleFormat          = "esm"
  generateFileExtension = "ts"
  importFileExtension   = "js"
}

datasource db {
  provider = "postgresql"
}

//BẢNG NGƯỜI DÙNG
enum Gender {
  male
  female
  other
}

enum UserRole {
  buyer
  seller
  admin
}

enum UserStatus {
  active
  locked
  deleted
}

model User {
  id              BigInt     @id @default(autoincrement())
  username        String     @unique @db.VarChar(50)
  email           String?    @unique @db.VarChar(255)
  phone           String?    @unique @db.VarChar(20)
  passwordHash    String     @map("password_hash") @db.VarChar(255)
  fullName        String?    @map("full_name") @db.VarChar(100)
  avatarUrl       String?    @map("avatar_url") @db.VarChar(500)
  gender          Gender?
  birthDate       DateTime?  @map("birth_date") @db.Date
  role            UserRole   @default(buyer)
  status          UserStatus @default(active)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz(3)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(3)
  shop            Shop?

  @@map("users")
}

model Category {
  id       BigInt  @id @default(autoincrement())
  parentId BigInt? @map("parent_id")
  name     String  @db.VarChar(100)
  slug     String  @unique @db.VarChar(120)
  level    Int     @default(1) @db.SmallInt
  path     String  @default("") @db.VarChar(255)
  iconUrl  String? @map("icon_url") @db.VarChar(500)
  position Int     @default(0)
  isLeaf   Boolean @default(true) @map("is_leaf")
  isActive Boolean @default(true) @map("is_active")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children Category[] @relation("CategoryTree")
  product  Product[]

  @@index([parentId], map: "idx_categories_parent")
  @@index([path], map: "idx_categories_path")
  @@map("categories")
}

enum ShopStatus {
  pending
  active
  suspended
  closed
}

model Shop {
  id            BigInt     @id @default(autoincrement())
  ownerId       BigInt     @unique @map("owner_id")
  name          String     @db.VarChar(100)
  slug          String     @unique @db.VarChar(120)
  description   String?    @db.Text
  logoUrl       String?    @map("logo_url") @db.VarChar(500)
  bannerUrl     String?    @map("banner_url") @db.VarChar(500)
  status        ShopStatus @default(pending)
  isOfficial    Boolean    @default(false) @map("is_official")
  ratingAvg     Decimal    @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount   Int        @default(0) @map("rating_count")
  followerCount Int        @default(0) @map("follower_count")
  responseRate  Decimal?   @map("response_rate") @db.Decimal(5, 2)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner   User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  product Product[]

  @@map("shops")
}

//San pham
enum ProductCondition {
  new
  used
}

enum ProductStatus {
  draft
  active
  hidden
  banned
  deleted
}

model Product {
  id            BigInt           @id @default(autoincrement())
  shopId        BigInt           @map("shop_id")
  categoryId    BigInt           @map("category_id")
  name          String           @db.VarChar(255)
  slug          String           @unique @db.VarChar(300)
  description   String?          @db.Text
  conditionType ProductCondition @default(new) @map("condition_type")
  weightGram    Int              @default(0) @map("weight_gram")
  lengthCm      Decimal?         @map("length_cm") @db.Decimal(6, 1)
  widthCm       Decimal?         @map("width_cm") @db.Decimal(6, 1)
  heightCm      Decimal?         @map("height_cm") @db.Decimal(6, 1)
  videoUrl      String?          @map("video_url") @db.VarChar(500)
  hasVariants   Boolean          @default(false) @map("has_variants")
  status        ProductStatus    @default(draft)
  preorderDays  Int?             @map("preorder_days") @db.SmallInt

  minPrice    BigInt  @default(0) @map("min_price")
  maxPrice    BigInt  @default(0) @map("max_price")
  totalStock  Int     @default(0) @map("total_stock")
  soldCount   Int     @default(0) @map("sold_count")
  viewCount   Int     @default(0) @map("view_count")
  likeCount   Int     @default(0) @map("like_count")
  ratingAvg   Decimal @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount Int     @default(0) @map("rating_count")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  shop     Shop           @relation(fields: [shopId], references: [id], onDelete: Restrict)
  category Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images   ProductImage[]
  tiers ProductTier[]
  models ProductModel[]

  @@index([shopId, status], map: "idx_products_shop")
  @@index([categoryId, status], map: "idx_products_category")
  @@index([soldCount], map: "idx_products_sold")
  @@index([minPrice], map: "idx_products_price")
  @@map("products")
}

model ProductImage {
  id        BigInt @id @default(autoincrement())
  productId BigInt @map("product_id")
  url       String @db.VarChar(500)
  position  Int    @default(0) @db.SmallInt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position], map: "idx_pimg_product")
  @@map("product_images")
}
model ProductTier {
  id        BigInt @id @default(autoincrement())
  productId BigInt @map("product_id")
  name      String @db.VarChar(30)
  position  Int    @db.SmallInt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  options TierOption[]

  @@unique([productId, position], map: "uq_tier_product_pos")
  @@map("product_tiers")
}
model TierOption {
  id       BigInt  @id @default(autoincrement())
  tierId   BigInt  @map("tier_id")
  value    String  @db.VarChar(50)
  imageUrl String? @map("image_url") @db.VarChar(500)
  position Int     @default(0) @db.SmallInt

  tier ProductTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  modelTierOptions ModelTierOption[]

  @@unique([tierId, value], map: "uq_tieropt_value")
  @@map("tier_options")
}

enum ProductModelStatus {
  active
  hidden
  deleted
}

model ProductModel {
  id            BigInt             @id @default(autoincrement())
  productId     BigInt             @map("product_id")
  sku           String?            @db.VarChar(100)
  name          String?            @db.VarChar(100)
  optionKey     String             @default("") @map("option_key") @db.VarChar(100)
  originalPrice BigInt             @map("original_price")
  price         BigInt
  imageUrl      String?            @map("image_url") @db.VarChar(500)
  status        ProductModelStatus @default(active)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tierOptions ModelTierOption[]
  inventory Inventory?

  @@unique([productId, optionKey], map: "uq_models_combo")
  @@unique([productId, sku], map: "uq_models_sku")
  @@map("product_models")
}

model ModelTierOption {
  modelId      BigInt @map("model_id")
  tierOptionId BigInt @map("tier_option_id")

  model      ProductModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  tierOption TierOption   @relation(fields: [tierOptionId], references: [id], onDelete: Cascade)

  @@id([modelId, tierOptionId])
  @@index([tierOptionId], map: "idx_mto_option")
  @@map("model_tier_options")
}
model Inventory {
  modelId       BigInt   @id @map("model_id")
  stock         Int      @default(0)
  reservedStock Int      @default(0) @map("reserved_stock")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  model ProductModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@map("inventories")
}