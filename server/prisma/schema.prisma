// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider              = "prisma-client"
  output                = "../src/generated/prisma"
  moduleFormat          = "esm"
  generateFileExtension = "ts"
  importFileExtension   = "js"
}

datasource db {
  provider = "postgresql"
}

//BẢNG NGƯỜI DÙNG
enum Gender {
  male
  female
  other
}

enum UserRole {
  buyer
  seller
  admin
}

enum UserStatus {
  active
  locked
  deleted
}

model User {
  id              BigInt        @id @default(autoincrement())
  username        String        @unique @db.VarChar(50)
  email           String?       @unique @db.VarChar(255)
  phone           String?       @unique @db.VarChar(20)
  passwordHash    String?       @map("password_hash") @db.VarChar(255)
  googleSub       String?       @unique @map("google_sub") @db.VarChar(255)
  fullName        String?       @map("full_name") @db.VarChar(100)
  avatarUrl       String?       @map("avatar_url") @db.VarChar(500)
  gender          Gender?
  birthDate       DateTime?     @map("birth_date") @db.Date
  role            UserRole      @default(buyer)
  status          UserStatus    @default(active)
  emailVerifiedAt DateTime?     @map("email_verified_at") @db.Timestamptz(3)
  phoneVerifiedAt DateTime?     @map("phone_verified_at") @db.Timestamptz(3)
  lastLoginAt     DateTime?     @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(3)
  shop            Shop?
  cartItems       CartItem[]
  addresses       UserAddress[]
  checkouts       Checkout[]
  orders          Order[]

  @@map("users")
}

model PendingRegistration {
  id             String   @id @default(uuid()) @db.Uuid
  email          String   @unique @db.VarChar(255)
  username       String   @db.VarChar(50)
  passwordHash   String   @map("password_hash") @db.VarChar(255)
  otpHash        String   @map("otp_hash") @db.VarChar(64)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  failedAttempts Int      @default(0) @map("failed_attempts")
  lastSentAt     DateTime @map("last_sent_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("pending_registrations")
}

model Category {
  id       BigInt  @id @default(autoincrement())
  parentId BigInt? @map("parent_id")
  name     String  @db.VarChar(100)
  slug     String  @unique @db.VarChar(120)
  level    Int     @default(1) @db.SmallInt
  path     String  @default("") @db.VarChar(255)
  iconUrl  String? @map("icon_url") @db.VarChar(500)
  position Int     @default(0)
  isLeaf   Boolean @default(true) @map("is_leaf")
  isActive Boolean @default(true) @map("is_active")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children Category[] @relation("CategoryTree")
  product  Product[]

  @@index([parentId], map: "idx_categories_parent")
  @@index([path], map: "idx_categories_path")
  @@map("categories")
}

enum ShopStatus {
  pending
  active
  suspended
  closed
}

model Shop {
  id            BigInt     @id @default(autoincrement())
  ownerId       BigInt     @unique @map("owner_id")
  name          String     @db.VarChar(100)
  slug          String     @unique @db.VarChar(120)
  description   String?    @db.Text
  logoUrl       String?    @map("logo_url") @db.VarChar(500)
  bannerUrl     String?    @map("banner_url") @db.VarChar(500)
  status        ShopStatus @default(pending)
  isOfficial    Boolean    @default(false) @map("is_official")
  ratingAvg     Decimal    @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount   Int        @default(0) @map("rating_count")
  followerCount Int        @default(0) @map("follower_count")
  responseRate  Decimal?   @map("response_rate") @db.Decimal(5, 2)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner   User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  product Product[]
  orders  Order[]

  @@map("shops")
}

//San pham
enum ProductCondition {
  new
  used
}

enum ProductStatus {
  draft
  active
  hidden
  banned
  deleted
}

model Product {
  id            BigInt           @id @default(autoincrement())
  shopId        BigInt           @map("shop_id")
  categoryId    BigInt           @map("category_id")
  name          String           @db.VarChar(255)
  slug          String           @unique @db.VarChar(300)
  description   String?          @db.Text
  conditionType ProductCondition @default(new) @map("condition_type")
  weightGram    Int              @default(0) @map("weight_gram")
  lengthCm      Decimal?         @map("length_cm") @db.Decimal(6, 1)
  widthCm       Decimal?         @map("width_cm") @db.Decimal(6, 1)
  heightCm      Decimal?         @map("height_cm") @db.Decimal(6, 1)
  videoUrl      String?          @map("video_url") @db.VarChar(500)
  hasVariants   Boolean          @default(false) @map("has_variants")
  status        ProductStatus    @default(draft)
  preorderDays  Int?             @map("preorder_days") @db.SmallInt

  minPrice    BigInt  @default(0) @map("min_price")
  maxPrice    BigInt  @default(0) @map("max_price")
  totalStock  Int     @default(0) @map("total_stock")
  soldCount   Int     @default(0) @map("sold_count")
  viewCount   Int     @default(0) @map("view_count")
  likeCount   Int     @default(0) @map("like_count")
  ratingAvg   Decimal @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount Int     @default(0) @map("rating_count")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  shop       Shop           @relation(fields: [shopId], references: [id], onDelete: Restrict)
  category   Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images     ProductImage[]
  tiers      ProductTier[]
  models     ProductModel[]
  orderItems OrderItem[]

  @@index([shopId, status], map: "idx_products_shop")
  @@index([categoryId, status], map: "idx_products_category")
  @@index([soldCount], map: "idx_products_sold")
  @@index([minPrice], map: "idx_products_price")
  @@map("products")
}

model ProductImage {
  id        BigInt @id @default(autoincrement())
  productId BigInt @map("product_id")
  url       String @db.VarChar(500)
  position  Int    @default(0) @db.SmallInt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position], map: "idx_pimg_product")
  @@map("product_images")
}

model ProductTier {
  id        BigInt @id @default(autoincrement())
  productId BigInt @map("product_id")
  name      String @db.VarChar(30)
  position  Int    @db.SmallInt

  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  options TierOption[]

  @@unique([productId, position], map: "uq_tier_product_pos")
  @@map("product_tiers")
}

model TierOption {
  id       BigInt  @id @default(autoincrement())
  tierId   BigInt  @map("tier_id")
  value    String  @db.VarChar(50)
  imageUrl String? @map("image_url") @db.VarChar(500)
  position Int     @default(0) @db.SmallInt

  tier             ProductTier       @relation(fields: [tierId], references: [id], onDelete: Cascade)
  modelTierOptions ModelTierOption[]

  @@unique([tierId, value], map: "uq_tieropt_value")
  @@map("tier_options")
}

enum ProductModelStatus {
  active
  hidden
  deleted
}

model ProductModel {
  id            BigInt             @id @default(autoincrement())
  productId     BigInt             @map("product_id")
  sku           String?            @db.VarChar(100)
  name          String?            @db.VarChar(100)
  optionKey     String             @default("") @map("option_key") @db.VarChar(100)
  originalPrice BigInt             @map("original_price")
  price         BigInt
  status        ProductModelStatus @default(active)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  tierOptions ModelTierOption[]
  inventory   Inventory?
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@unique([productId, optionKey], map: "uq_models_combo")
  @@unique([productId, sku], map: "uq_models_sku")
  @@map("product_models")
}

model ModelTierOption {
  modelId      BigInt @map("model_id")
  tierOptionId BigInt @map("tier_option_id")

  model      ProductModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  tierOption TierOption   @relation(fields: [tierOptionId], references: [id], onDelete: Cascade)

  @@id([modelId, tierOptionId])
  @@index([tierOptionId], map: "idx_mto_option")
  @@map("model_tier_options")
}

model Inventory {
  modelId       BigInt   @id @map("model_id")
  stock         Int      @default(0)
  reservedStock Int      @default(0) @map("reserved_stock")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  model ProductModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@map("inventories")
}

model CartItem {
  id       BigInt  @id @default(autoincrement())
  userId   BigInt  @map("user_id")
  modelId  BigInt  @map("model_id")
  quantity Int     @default(1)
  selected Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  model ProductModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([userId, modelId], map: "uq_cart_user_model")
  @@index([modelId], map: "idx_cart_model")
  @@map("cart_items")
}

enum AddressType {
  home
  office
}

model Province {
  id   Int    @id @default(autoincrement())
  code String @unique @db.VarChar(10)
  name String @db.VarChar(100)

  wards Ward[]

  @@map("provinces")
}

model Ward {
  id         Int    @id @default(autoincrement())
  provinceId Int    @map("province_id")
  code       String @unique @db.VarChar(10)
  name       String @db.VarChar(100)

  province  Province      @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  addresses UserAddress[]

  @@index([provinceId], map: "idx_wards_province")
  @@map("wards")
}

model UserAddress {
  id            BigInt      @id @default(autoincrement())
  userId        BigInt      @map("user_id")
  wardId        Int         @map("ward_id")
  receiverName  String      @map("receiver_name") @db.VarChar(100)
  receiverPhone String      @map("receiver_phone") @db.VarChar(20)
  addressDetail String      @map("address_detail") @db.VarChar(255)
  addressType   AddressType @default(home) @map("address_type")
  isDefault     Boolean     @default(false) @map("is_default")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?   @map("deleted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  ward Ward @relation(fields: [wardId], references: [id], onDelete: Restrict)

  @@index([userId], map: "idx_addr_user")
  @@index([wardId], map: "idx_addr_ward")
  @@map("user_addresses")
}

enum PaymentMethod {
  cod
  bank_transfer
  card
  ewallet
}

enum PaymentStatus {
  unpaid
  paid
  failed
  refunded
}

model Checkout {
  id           BigInt @id @default(autoincrement())
  checkoutCode String @unique @map("checkout_code") @db.VarChar(30)
  userId       BigInt @map("user_id")

  subtotal      BigInt
  shippingTotal BigInt @default(0) @map("shipping_total")
  discountTotal BigInt @default(0) @map("discount_total")
  grandTotal    BigInt @map("grand_total")

  paymentMethod PaymentMethod @map("payment_method")
  paymentStatus PaymentStatus @default(unpaid) @map("payment_status")

  idempotencyKey String @map("idempotency_key") @db.Uuid
  requestHash    String @map("request_hash") @db.Char(64)

  expiresAt DateTime? @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  orders Order[]

  @@unique([userId, idempotencyKey], map: "uq_checkouts_user_idempotency")
  @@index([userId, createdAt], map: "idx_checkouts_user")
  @@map("checkouts")
}

enum OrderStatus {
  pending_payment
  pending_confirm
  to_ship
  shipping
  delivered
  completed
  cancelled
  return_refund
}

enum OrderCancelledBy {
  buyer
  seller
  system
}

model Order {
  id         BigInt      @id @default(autoincrement())
  orderCode  String      @unique @map("order_code") @db.VarChar(30)
  checkoutId BigInt      @map("checkout_id")
  userId     BigInt      @map("user_id")
  shopId     BigInt      @map("shop_id")
  status     OrderStatus @default(pending_confirm)

  // Bản sao thông tin nhận hàng tại thời điểm đặt.
  receiverName    String @map("receiver_name") @db.VarChar(100)
  receiverPhone   String @map("receiver_phone") @db.VarChar(20)
  shippingAddress String @map("shipping_address") @db.VarChar(500)
  provinceId      Int?   @map("province_id")
  wardId          Int?   @map("ward_id")

  subtotal                BigInt
  shippingFee             BigInt @default(0) @map("shipping_fee")
  shopVoucherDiscount     BigInt @default(0) @map("shop_voucher_discount")
  platformVoucherDiscount BigInt @default(0) @map("platform_voucher_discount")
  totalAmount             BigInt @map("total_amount")

  buyerNote    String?           @map("buyer_note") @db.VarChar(500)
  cancelReason String?           @map("cancel_reason") @db.VarChar(255)
  cancelledBy  OrderCancelledBy? @map("cancelled_by")

  paidAt      DateTime? @map("paid_at") @db.Timestamptz(3)
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(3)
  shippedAt   DateTime? @map("shipped_at") @db.Timestamptz(3)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  checkout Checkout @relation(fields: [checkoutId], references: [id], onDelete: Restrict)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Restrict)

  items OrderItem[]

  @@unique([checkoutId, shopId], map: "uq_orders_checkout_shop")
  @@index([userId, status, createdAt], map: "idx_orders_user")
  @@index([shopId, status, createdAt], map: "idx_orders_shop")
  @@map("orders")
}

model OrderItem {
  id        BigInt  @id @default(autoincrement())
  orderId   BigInt  @map("order_id")
  productId BigInt? @map("product_id")
  modelId   BigInt? @map("model_id")

  // Bản sao thông tin sản phẩm tại thời điểm đặt hàng.
  productName String  @map("product_name") @db.VarChar(255)
  modelName   String? @map("model_name") @db.VarChar(100)
  sku         String? @db.VarChar(100)
  imageUrl    String? @map("image_url") @db.VarChar(500)

  unitPrice     BigInt @map("unit_price")
  originalPrice BigInt @map("original_price")
  quantity      Int
  lineTotal     BigInt @map("line_total")

  isReviewed Boolean @default(false) @map("is_reviewed")

  order   Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  model   ProductModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)

  @@index([orderId], map: "idx_oi_order")
  @@index([productId], map: "idx_oi_product")
  @@index([modelId], map: "idx_oi_model")
  @@map("order_items")
}
